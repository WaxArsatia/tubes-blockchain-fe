{
  "name": "frontend",
  "private": true,
  "type": "module",
  "//": "Remove the ws override after viem publishes a release that depends on ws 8.21.0 or newer.",
  "overrides": {
    "ws": "8.21.0"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "bun run build && wrangler dev",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:wallet:local": "bun e2e/run-wallet-e2e.ts --target local",
    "test:e2e:wallet:local:ui": "bun e2e/run-wallet-e2e.ts --target local --ui",
    "test:e2e:wallet:real": "bun e2e/run-wallet-e2e.ts --target real",
    "test:e2e:wallet:real:ui": "bun e2e/run-wallet-e2e.ts --target real --ui",
    "test:real-rpc": "bun e2e/run-wallet-e2e.ts --target real",
    "test:real-rpc:ui": "bun e2e/run-wallet-e2e.ts --target real --ui",
    "lint": "eslint",
    "format": "prettier --write \"{e2e,src}/**/*.{ts,tsx,js,jsx}\" \"*.{ts,js}\"",
    "check": "prettier --check \"{e2e,src}/**/*.{ts,tsx,js,jsx}\" \"*.{ts,js}\"",
    "typecheck": "tsc --noEmit",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "1.170.16",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.26",
    "@tanstack/router-plugin": "1.168.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.21.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "viem": "^2.53.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.42.1",
    "@playwright/test": "^1.61.0",
    "@tanstack/devtools-vite": "0.8.0",
    "@tanstack/eslint-config": "0.4.0",
    "@tanstack/react-devtools": "0.10.7",
    "@tanstack/react-router-devtools": "1.167.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "esbuild": "0.28.1",
    "eslint": "^9",
    "jsdom": "^28",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6",
    "vite": "^8",
    "vitest": "^4",
    "wrangler": "^4.103.0"
  }
}
